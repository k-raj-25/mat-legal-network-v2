APP_NAME="MAT LEGAL NETWORK"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_TIMEZONE=Asia/Kolkata

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mat_legal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- MAT LEGAL NETWORK ----
# First admin account (used by `php artisan mat:create-admin` and the seeder)
ADMIN_NAME="MAT Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Address that receives new-registration and new-enquiry alerts
ADMIN_NOTIFY_EMAIL=admin@example.com
SEARCH_RATE_LIMIT=90

# ---- AI spam screening of enquiries (optional) ----
# Paste an Anthropic API key (https://console.anthropic.com > API keys) to turn it on. Never commit a real key.
# Without a key, or if the API fails, every enquiry is handled as normal.
ANTHROPIC_API_KEY=
SPAM_AI_ENABLED=true
SPAM_AI_MODEL=claude-opus-5-5
# Confidence (0-100) needed before an enquiry is held in "Suspected spam"
SPAM_AI_THRESHOLD=80
SPAM_AI_TIMEOUT=20
